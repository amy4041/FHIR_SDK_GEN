<Project DefaultTargets="Build">
  <PropertyGroup>
    <Configuration Condition="'$(Configuration)' == ''">Release</Configuration>
    <RepositoryRoot>$([System.IO.Path]::GetFullPath('$(MSBuildThisFileDirectory)..\'))</RepositoryRoot>
    <PackageOutputPath Condition="'$(PackageOutputPath)' == ''">$(RepositoryRoot)artifacts\packages</PackageOutputPath>
  </PropertyGroup>

  <Target Name="Restore">
    <MSBuild Projects="$(RepositoryRoot)Runtime\MyFhirSdk.Runtime.csproj"
             Targets="Restore" />
    <MSBuild Projects="$(RepositoryRoot)CodeGen\MyFhirSdk.CodeGen.csproj"
             Targets="Restore" />
  </Target>

  <Target Name="Build">
    <Error Condition="'$(Configuration)' != 'Release'"
           Text="The CodeGen Runtime reference pipeline requires Configuration=Release." />
    <MSBuild Projects="$(RepositoryRoot)Runtime\MyFhirSdk.Runtime.csproj"
             Targets="GetCompilerReferenceAsset"
             Properties="Configuration=$(Configuration)">
      <Output TaskParameter="TargetOutputs" ItemName="RuntimeReferenceAsset" />
    </MSBuild>
    <Error Condition="'@(RuntimeReferenceAsset)' == ''"
           Text="The Runtime build did not produce a Runtime reference asset." />
    <PropertyGroup>
      <RuntimeReferenceAssetPath>@(RuntimeReferenceAsset->'%(FullPath)')</RuntimeReferenceAssetPath>
    </PropertyGroup>
    <MSBuild Projects="$(RepositoryRoot)CodeGen\MyFhirSdk.CodeGen.csproj"
             Targets="Build"
             Properties="Configuration=$(Configuration);RuntimeReferenceAssetPath=$(RuntimeReferenceAssetPath)" />
  </Target>

  <Target Name="Pack" DependsOnTargets="Build">
    <MakeDir Directories="$(PackageOutputPath)" />
    <MSBuild Projects="$(RepositoryRoot)CodeGen\MyFhirSdk.CodeGen.csproj"
             Targets="Pack"
             Properties="Configuration=$(Configuration);NoBuild=true;RuntimeReferenceAssetPath=$(RuntimeReferenceAssetPath);PackageOutputPath=$(PackageOutputPath)" />
  </Target>

  <Target Name="GetRuntimeCompilerReferenceAsset" Returns="@(RuntimeKernelReferenceAsset)">
    <MSBuild Projects="$(RepositoryRoot)Runtime\MyFhirSdk.Runtime.csproj"
             Targets="GetCompilerReferenceAsset" Properties="Configuration=$(Configuration)">
      <Output TaskParameter="TargetOutputs" ItemName="RuntimeKernelReferenceAsset" />
    </MSBuild>
  </Target>

  <Target Name="Clean">
    <MSBuild Projects="$(RepositoryRoot)MyFhirSdk.csproj;$(RepositoryRoot)Runtime\MyFhirSdk.Runtime.csproj;$(RepositoryRoot)CodeGen\MyFhirSdk.CodeGen.csproj"
             Targets="Clean" Properties="Configuration=$(Configuration)" />
  </Target>
</Project>
