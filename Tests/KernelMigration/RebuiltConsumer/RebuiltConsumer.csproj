<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>$(MyFhirSdkTargetFramework)</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <EnableDefaultCompileItems>false</EnableDefaultCompileItems>
  </PropertyGroup>
  <ItemGroup>
    <Compile Include="Program.cs" />
    <ProjectReference Include="../RebuiltLibrary/RebuiltLibrary.csproj" />
    <Reference Include="MyFhirSdk"><HintPath>$(SdkAssemblyPath)</HintPath></Reference>
    <Reference Include="MyFhirSdk.Runtime"><HintPath>$(RuntimeAssemblyPath)</HintPath></Reference>
  </ItemGroup>
  <Target Name="RequireImplementationAssemblies" BeforeTargets="ResolveReferences">
    <Error Condition="!Exists('$(SdkAssemblyPath)') or !Exists('$(RuntimeAssemblyPath)')" Text="Explicit SDK and Runtime implementation assemblies are required." />
  </Target>
</Project>
