<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>$(MyFhirSdkTargetFramework)</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <EnableDefaultCompileItems>false</EnableDefaultCompileItems>
  </PropertyGroup>
  <ItemGroup>
    <Compile Include="Program.cs" />
    <Reference Include="MyFhirSdk"><HintPath>$(SdkAssemblyPath)</HintPath></Reference>
    <Reference Include="MyFhirSdk.Runtime" Condition="'$(RuntimeAssemblyPath)' != ''"><HintPath>$(RuntimeAssemblyPath)</HintPath></Reference>
  </ItemGroup>
  <Target Name="RequireExplicitSdk" BeforeTargets="ResolveReferences">
    <Error Condition="!Exists('$(SdkAssemblyPath)')" Text="An explicit SDK implementation assembly is required." />
  </Target>
</Project>
