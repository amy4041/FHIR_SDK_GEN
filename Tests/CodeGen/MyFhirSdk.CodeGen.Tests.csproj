<Project Sdk="Microsoft.NET.Sdk"
         TreatAsLocalProperty="CodeGenToolPackageConfiguration">
  <PropertyGroup>
    <TargetFramework>$(MyFhirSdkTargetFramework)</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <IsTestProject>true</IsTestProject>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="18.0.1" />
    <PackageReference Include="xunit" Version="2.9.3" />
    <PackageReference Include="xunit.runner.visualstudio" Version="2.8.2">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageReference>
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\CodeGen\MyFhirSdk.CodeGen.csproj" />
    <ProjectReference Include="..\..\MyFhirSdk.csproj" />
  </ItemGroup>

  <ItemGroup>
    <None Update="Fixtures\**\*.json">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
    <None Update="Fixtures\StructureDefinitions\Primitives\R5\SHA256SUMS.txt">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
    <None Update="Fixtures\FhirPackages\**\*.tgz">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
    <None Include="..\..\CodeGen\Policy\r5-package-lock.json">
      <Link>Policy\r5-package-lock.json</Link>
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
    <None Include="..\..\CodeGen\Policy\primitive-generation-policy.json">
      <Link>Policy\primitive-generation-policy.json</Link>
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
    <None Include="..\..\CodeGen\Policy\runtime-contract.json">
      <Link>Policy\runtime-contract.json</Link>
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
    <None Include="..\..\CodeGen\Policy\r5-model-ownership-policy.json">
      <Link>Policy\r5-model-ownership-policy.json</Link>
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
    <None Include="..\..\CodeGen\Policy\r5-model-naming-policy.json">
      <Link>Policy\r5-model-naming-policy.json</Link>
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
    <None Include="..\..\CodeGen\Policy\r5-backbone-policy.json">
      <Link>Policy\r5-backbone-policy.json</Link>
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
    <None Include="..\..\CodeGen\Policy\r5-choice-open-type-policy.json">
      <Link>Policy\r5-choice-open-type-policy.json</Link>
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
    <None Include="..\..\CodeGen\Policy\r5-validation-capability-policy.json">
      <Link>Policy\r5-validation-capability-policy.json</Link>
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
    <None Update="GoldenFiles\**\*.txt">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
    <None Include="..\..\Generated\R5\Primitives\*">
      <Link>CommittedGenerated\R5\Primitives\%(Filename)%(Extension)</Link>
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
    <None Include="..\..\Generated\R5\model-generation-manifest.json">
      <Link>CommittedGenerated\R5\model-generation-manifest.json</Link>
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
    <None Include="..\..\.config\dotnet-tools.json">
      <Link>RepositoryToolManifest\dotnet-tools.json</Link>
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
    <None Update="Packaging\codegen-tool-package-layout.txt">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
  </ItemGroup>

  <Target Name="StageTestRuntimeReference" AfterTargets="Build">
    <PropertyGroup>
      <TestRuntimeReferenceDirectory>$(TargetDir)Assets\RuntimeReferences\$(TargetFramework)</TestRuntimeReferenceDirectory>
    </PropertyGroup>
    <ItemGroup Condition="'$(RuntimeReferenceAssetPath)' != ''">
      <TestRuntimeReferenceAsset Include="$(RuntimeReferenceAssetPath)" />
    </ItemGroup>
    <MSBuild Projects="..\..\MyFhirSdk.csproj"
             Targets="GetCompilerReferenceAsset"
             Properties="Configuration=Release"
             Condition="'$(RuntimeReferenceAssetPath)' == ''">
      <Output TaskParameter="TargetOutputs" ItemName="TestRuntimeReferenceAsset" />
    </MSBuild>
    <Error Condition="'@(TestRuntimeReferenceAsset)' == ''"
           Text="A Runtime compiler reference asset is required for CodeGen tests." />
    <Error Condition="!Exists('%(TestRuntimeReferenceAsset.FullPath)')"
           Text="The Runtime compiler reference asset for CodeGen tests does not exist." />
    <MakeDir Directories="$(TestRuntimeReferenceDirectory)" />
    <Copy SourceFiles="@(TestRuntimeReferenceAsset)"
          DestinationFiles="$(TestRuntimeReferenceDirectory)\MyFhirSdk.dll" />
  </Target>

  <Target Name="StageCodeGenToolPackages"
          AfterTargets="Build"
          DependsOnTargets="StageTestRuntimeReference">
    <PropertyGroup>
      <CodeGenToolPackageRoot>$(TargetDir)ToolPackages</CodeGenToolPackageRoot>
      <CodeGenToolPackageFirst>$(CodeGenToolPackageRoot)\first</CodeGenToolPackageFirst>
      <CodeGenToolPackageSecond>$(CodeGenToolPackageRoot)\second</CodeGenToolPackageSecond>
      <CodeGenToolPackageConfiguration>Release</CodeGenToolPackageConfiguration>
      <TestRuntimeReferenceAssetPath>@(TestRuntimeReferenceAsset->'%(FullPath)')</TestRuntimeReferenceAssetPath>
    </PropertyGroup>
    <RemoveDir Directories="$(CodeGenToolPackageRoot)" />
    <MakeDir Directories="$(CodeGenToolPackageFirst);$(CodeGenToolPackageSecond)" />
    <MSBuild Projects="..\..\CodeGen\MyFhirSdk.CodeGen.csproj"
             Targets="Pack"
             Properties="Configuration=$(CodeGenToolPackageConfiguration);RuntimeReferenceAssetPath=$(TestRuntimeReferenceAssetPath);PackageOutputPath=$(CodeGenToolPackageFirst)" />
    <MSBuild Projects="..\..\CodeGen\MyFhirSdk.CodeGen.csproj"
             Targets="Pack"
             Properties="Configuration=$(CodeGenToolPackageConfiguration);RuntimeReferenceAssetPath=$(TestRuntimeReferenceAssetPath);PackageOutputPath=$(CodeGenToolPackageSecond)" />
  </Target>
</Project>
