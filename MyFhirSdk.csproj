<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>$(MyFhirSdkTargetFramework)</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
  </PropertyGroup>
  <ItemGroup>
    <Compile Remove="Runtime\**\*.cs" />
    <Compile Remove="artifacts\**\*.cs" />
    <Compile Remove="CodeGen\**\*.cs" />
    <Compile Remove="core\bin\**\*.cs" />
    <Compile Remove="core\obj\**\*.cs" />
    <Compile Remove="Tests\**\*.cs" />
  </ItemGroup>
  <Import Project="Runtime\KernelCompileItems.props" />
  <ItemGroup>
    <Compile Remove="@(RuntimeKernelSource)" />
    <ProjectReference Include="Runtime\MyFhirSdk.Runtime.csproj" />
  </ItemGroup>

</Project>
