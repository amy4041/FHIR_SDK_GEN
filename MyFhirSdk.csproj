<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>$(MyFhirSdkTargetFramework)</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <!-- Exclude non-SDK trees before default globs enumerate their build/cache
         outputs; Compile Remove below retains the explicit ownership boundary. -->
    <DefaultItemExcludes>$(DefaultItemExcludes);artifacts/**;Tests/**;CodeGen/**;Runtime/**;ModelContracts/**;ModelSupport/**;Models/**;Generated/**</DefaultItemExcludes>
  </PropertyGroup>
  <ItemGroup>
    <Compile Remove="Runtime\**\*.cs" />
    <Compile Remove="ModelContracts\**\*.cs" />
    <Compile Remove="ModelSupport\**\*.cs;Models\**\*.cs;Generated\**\*.cs;Types\SimpleQuantity.cs" />
    <Compile Remove="artifacts\**\*.cs" />
    <Compile Remove="CodeGen\**\*.cs" />
    <Compile Remove="core\bin\**\*.cs" />
    <Compile Remove="core\obj\**\*.cs" />
    <Compile Remove="Tests\**\*.cs" />
  </ItemGroup>
  <Import Project="Runtime\KernelCompileItems.props" />
  <ItemGroup>
    <Compile Remove="@(RuntimeKernelSource)" />
    <ProjectReference Include="Runtime\MyFhirSdk.Runtime.csproj" />
    <ProjectReference Include="ModelContracts\MyFhirSdk.ModelContracts.csproj" />
    <ProjectReference Include="ModelSupport\MyFhirSdk.ModelSupport.csproj" />
    <ProjectReference Include="Models\R5\MyFhirSdk.R5.Models.csproj" />
  </ItemGroup>

</Project>
