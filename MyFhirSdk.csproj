<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>$(MyFhirSdkTargetFramework)</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <Deterministic>true</Deterministic>
    <IncludeSourceRevisionInInformationalVersion>false</IncludeSourceRevisionInInformationalVersion>
    <PathMap>$(MSBuildProjectDirectory)=/_/</PathMap>
  </PropertyGroup>
  <ItemGroup>
    <Compile Remove="CodeGen\**\*.cs" />
    <Compile Remove="core\bin\**\*.cs" />
    <Compile Remove="core\obj\**\*.cs" />
    <Compile Remove="Tests\**\*.cs" />
  </ItemGroup>

  <Target Name="GetCompilerReferenceAsset"
          DependsOnTargets="Build"
          Returns="@(CompilerReferenceAsset)">
    <ItemGroup>
      <CompilerReferenceAsset Include="$(TargetRefPath)" />
    </ItemGroup>
    <Error Condition="!Exists('$(TargetRefPath)')"
           Text="The SDK build did not produce its compiler reference assembly." />
  </Target>
</Project>
