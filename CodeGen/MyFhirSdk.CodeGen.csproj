<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net9.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <RuntimeReferenceTargetPath>Assets\RuntimeReferences\$(TargetFramework)\MyFhirSdk.dll</RuntimeReferenceTargetPath>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.CodeAnalysis.CSharp" Version="5.0.0" />
  </ItemGroup>
  <ItemGroup>
    <None Update="Policy\primitive-generation-policy.json">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
    <None Update="Policy\r5-model-ownership-policy.json">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
    <None Update="Policy\r5-model-naming-policy.json">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
    <None Update="Policy\r5-backbone-policy.json">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
    <None Update="Policy\r5-choice-open-type-policy.json">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
    <None Update="Policy\r5-validation-capability-policy.json">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
    <None Update="Policy\runtime-contract.json">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
    <None Include="$(RuntimeReferenceAssetPath)"
          Condition="'$(RuntimeReferenceAssetPath)' != ''">
      <Link>$(RuntimeReferenceTargetPath)</Link>
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
  </ItemGroup>
  <Target Name="ValidateRuntimeReferenceAssetInput"
          BeforeTargets="PrepareForBuild"
          Condition="'$(RuntimeReferenceAssetPath)' != ''">
    <Error Condition="!Exists('$(RuntimeReferenceAssetPath)')"
           Text="The explicit RuntimeReferenceAssetPath does not exist." />
  </Target>
  <Target Name="RequireRuntimeReferenceAssetForPack"
          BeforeTargets="Pack"
          Condition="'$(RuntimeReferenceAssetPath)' == ''">
    <Error Text="RuntimeReferenceAssetPath is required when packaging CodeGen." />
  </Target>
</Project>
